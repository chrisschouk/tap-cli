Output scripts/demos/output/tap-cli-demo.gif
Set FontSize 14
Set Width 1200
Set Height 600
Set Theme "Catppuccin Mocha"
Set Padding 20
Set CursorBlink false
Set TypingSpeed 40ms
Set WindowBar Colorful
Set WindowBarSize 28
Set BorderRadius 8
Set MarginFill "#0891B2"
Set Margin 40
Env PS1 "$ "
Env RPROMPT ""

Hide
Type "clear"
Enter
Show

Sleep 500ms

Type "tap stats"
Sleep 300ms
Enter
Sleep 7s

Hide
Type "clear"
Enter
Show

Type "tap contacts list"
Sleep 300ms
Enter
Sleep 3s

Hide
Type "clear"
Enter
Show

Type "tap queue"
Sleep 300ms
Enter
Sleep 3s

Sleep 1s
