{
  "name": "@totalaudiopromo/tap-cli",
  "version": "0.3.1",
  "description": "CLI for Total Audio Platform — manage campaigns, contacts, pitches, and workspace skills from the terminal. 0.3 routes auth through REST v1 with workspace-scoped tap_ak_* keys.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tap": "dist/cli.js"
  },
  "main": "./dist/cli.js",
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@clack/prompts": "^0.9.1",
    "@supabase/supabase-js": "^2.49.3",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cli",
    "music",
    "pr",
    "campaigns",
    "contacts",
    "radio",
    "total-audio"
  ],
  "homepage": "https://github.com/totalaudiopromo/tap-cli#readme",
  "bugs": {
    "url": "https://github.com/totalaudiopromo/tap-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/totalaudiopromo/tap-cli.git"
  },
  "author": "Total Audio Promo",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ]
}
